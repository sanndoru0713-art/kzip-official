# ──────────────────────────────────────────────
# K:ZIP 홈페이지 환경변수
# 이 파일을 복사해 .env.local 을 만들고 실제 값을 채우세요.
# 실제 키 값은 절대 Git에 커밋하지 마세요.
# ──────────────────────────────────────────────

# 사이트 URL (배포 도메인 확정 후 입력)
NEXT_PUBLIC_SITE_URL=

# Notion Integration Secret (https://www.notion.so/my-integrations 에서 발급)
NOTION_API_KEY=

# Notion CMS 데이터베이스 ID (README의 "Database ID 확인 방법" 참고)
NOTION_SITE_DATABASE_ID=
NOTION_SERVICES_DATABASE_ID=
NOTION_PROJECTS_DATABASE_ID=
NOTION_INSIGHTS_DATABASE_ID=
NOTION_PROFILE_DATABASE_ID=

# Notion 문의 CRM 데이터베이스 ID
NOTION_CRM_DATABASE_ID=

# 즉시 반영용 시크릿 (임의의 긴 문자열) — /api/revalidate?secret=이_값
# 미설정 시 즉시 반영 엔드포인트는 비활성화되며, ISR 5분 주기로만 갱신됩니다.
REVALIDATE_SECRET=

# ──────────────────────────────────────────────
# K:ZIP Search Lab (SEO·AEO·GEO·보안 대시보드) — /dashboard
# 모든 키는 서버 전용. 프론트엔드에 노출되지 않습니다.
# 미설정 시 해당 기능은 가짜 수치 대신 "데이터 연결 필요"로 표시됩니다.
# ──────────────────────────────────────────────

# Google PageSpeed Insights — Core Web Vitals 실측 (없어도 동작하나 쿼터 낮음)
# Google Cloud Console에서 "PageSpeed Insights API" 키 발급
PSI_API_KEY=

# AI 수정안 생성 (Title·Meta·FAQ·JSON-LD·ALT 등 초안 생성)
ANTHROPIC_API_KEY=

# Google Search Console / GA4 연동 (2차 개발)
# 서비스 계정 JSON(문자열)과 대상 속성 지정. 서비스 계정 이메일을
# Search Console 속성 사용자 / GA4 속성 뷰어로 추가해야 합니다.
GOOGLE_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=
GA4_PROPERTY_ID=

# Bing Webmaster Tools
BING_WEBMASTER_API_KEY=

# 소유권 인증 토큰 솔트 (보안 확장 점검 전 사이트 소유권 확인용)
OWNERSHIP_SALT=
