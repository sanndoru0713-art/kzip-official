# ──────────────────────────────────────────────
# K:ZIP 홈페이지 환경변수
# 이 파일을 복사해 .env.local 을 만들고 실제 값을 채우세요.
# 실제 키 값은 절대 Git에 커밋하지 마세요.
# ──────────────────────────────────────────────

# 사이트 URL (배포 도메인 확정 후 입력)
NEXT_PUBLIC_SITE_URL=

# Notion Integration Secret (https://www.notion.so/my-integrations 에서 발급)
NOTION_API_KEY=

# Notion CMS 데이터베이스 ID (README의 "Database ID 확인 방법" 참고)
NOTION_SITE_DATABASE_ID=
NOTION_SERVICES_DATABASE_ID=
NOTION_PROJECTS_DATABASE_ID=
NOTION_INSIGHTS_DATABASE_ID=
NOTION_PROFILE_DATABASE_ID=

# Notion 문의 CRM 데이터베이스 ID
NOTION_CRM_DATABASE_ID=

# 즉시 반영용 시크릿 (임의의 긴 문자열) — /api/revalidate?secret=이_값
# 미설정 시 즉시 반영 엔드포인트는 비활성화되며, ISR 5분 주기로만 갱신됩니다.
REVALIDATE_SECRET=

# ──────────────────────────────────────────────
# 분석·검색엔진 도구 (선택 — 미설정 시 관련 태그가 출력되지 않습니다)
# ──────────────────────────────────────────────

# Google Tag Manager 컨테이너 ID (예: GTM-XXXXXXX)
# GTM 설정 시 GA4는 GTM 안에서 관리하는 것을 권장합니다.
NEXT_PUBLIC_GTM_ID=

# GA4 측정 ID (예: G-XXXXXXXXXX) — GTM 미사용 시에만 설정
NEXT_PUBLIC_GA4_ID=

# 검색엔진 소유 확인 코드 (meta 태그의 content 값만 입력)
# Google Search Console → 소유권 확인 → HTML 태그 방식
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저 → 사이트 소유 확인 → HTML 태그 방식
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
# Bing Webmaster Tools → 사이트 확인 → 메타 태그 방식
NEXT_PUBLIC_BING_SITE_VERIFICATION=
